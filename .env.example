# Repo-root environment template.
# Copy to `.env` and fill in your secrets. Do NOT commit `.env`.
# Non-secret tunables live in settings/config.yaml. Model selection lives in
# settings/llm.yaml (the prefix — openai/, azure/, anthropic/, gemini/ —
# decides which of the keys below LiteLLM uses).

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
# DATABASE_URL=
# SYNC_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── LLM providers ────────────────────────────────────────────────────────────
# openai/…
# OPENAI_API_KEY=

# azure/…
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-05-01-preview

# anthropic/…  (Claude)
# ANTHROPIC_API_KEY=

# gemini/…
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# QDRANT_API_KEY=
# GROQ_API_KEY=
# BREVO_API_KEY=
