# Secrets and local overrides. Copy to `.env` and fill in.
# Pick the chat/embedding model in ../settings/llm.yaml.
# LiteLLM uses the model prefix to choose which key below to send.

# openai/…
OPENAI_API_KEY=

# azure/…
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# anthropic/…  (Claude)
# ANTHROPIC_API_KEY=

# gemini/…
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL=
# SYNC_DATABASE_URL=

# Auth
JWT_SECRET_KEY=change-me-in-production

# Optional
# QDRANT_API_KEY=
# GROQ_API_KEY=
# REDIS_URL=
