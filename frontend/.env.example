# Public base URL the browser uses to reach the app's own API routes / proxy.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side URL of the FastAPI backend (used by next.config rewrites and
# server components / route handlers). Not exposed to the browser.
BACKEND_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME="AI Mock Interview Platform"
